# Stage 1: Build ken from source
FROM golang:1.23-bookworm AS builder

ARG KEN_VERSION

WORKDIR /build

# Clone kaia repository and checkout version
RUN git clone https://github.com/kaiachain/kaia.git . \
    && git checkout "${KEN_VERSION}"

# Build ken (Endpoint Node)
RUN make ken

# Stage 2: Runtime
FROM debian:bookworm-slim

ARG USER=kaia
ARG UID=1000

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata bash curl wget lz4 jq tar aria2 \
    && rm -rf /var/lib/apt/lists/*

VOLUME /kaia

# Create non-root user
RUN adduser \
    --disabled-password \
    --gecos "" \
    --shell "/sbin/nologin" \
    --uid "${UID}" \
    "${USER}"

# Create data directories
RUN mkdir -p /kaia/data /kaia/logs \
    && chown -R ${USER}:${USER} /kaia && chmod -R 700 /kaia

# Copy ken binary
COPY --from=builder /build/build/bin/ken /usr/local/bin/ken

# Copy entrypoint script
COPY ./docker-entrypoint.sh /usr/local/bin/

# Make scripts executable
RUN chmod -R 755 /usr/local/bin/*

USER ${USER}

ENTRYPOINT ["docker-entrypoint.sh"]
