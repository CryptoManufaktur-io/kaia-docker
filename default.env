COMPOSE_FILE=kaia.yml
NETWORK=mainnet
PROJECT_NAME=kaia

# Kaia Docker image tag
# Official images: https://hub.docker.com/r/kaiachain/kaia/tags
# Latest: v2.2.2 (March 2026, includes Osaka hardfork)
KAIA_TAG=v2.2.2

# Snapshot URL for fast sync (HIGHLY RECOMMENDED)
# Latest snapshots: https://packages.kaia.io/mainnet/chaindata/
#
# Leave empty to sync from genesis (very slow, 5-7+ days)
# Or set to a snapshot URL for faster initial sync (3-9 hours)
SNAPSHOT=

# Live-pruning snapshot (RECOMMENDED for production):
# - Size: ~2.4TB compressed / ~2.9TB uncompressed
# - Enables state pruning for disk efficiency
# - MUST use LIVE_PRUNING=true with this snapshot
# SNAPSHOT=https://storage.googleapis.com/kaia-chaindata/mainnet/pruning-chaindata/kaia-mainnet-pruning-chaindata-latest.tar.gz

# Full snapshot (for archive nodes):
# - Size: ~1.9TB compressed / ~2.4TB uncompressed
# - Keeps full state history
# SNAPSHOT=https://storage.googleapis.com/kaia-chaindata/mainnet/kaia-mainnet-chaindata-latest.tar.gz

# Snapshot extraction: number of leading path components to strip
# Usually 0 for Kaia snapshots (they extract to the correct structure)
# To verify: curl -sL <snapshot-url> | tar -tzf - | head
# If archive starts with a wrapper directory (e.g. chaindata/...), set to 1
SNAPSHOT_STRIP_COMPONENTS=0

# Port configuration
P2P_PORT=32323
RPC_PORT=8551
WS_PORT=8552

# RPC configuration
# Do not expose admin/personal modules publicly.
RPC_ENABLE=1
RPC_ADDR=0.0.0.0
RPC_API=eth,net,web3,klay,kaia,txpool,rpc

# WebSocket configuration
WS_ENABLE=1
WS_ADDR=0.0.0.0
WS_API=eth,net,web3,klay,kaia,txpool,rpc

# Live pruning configuration
# WARNING: Live-pruning DBs are incompatible with non-live-pruning DBs
# Set to true for disk efficiency (recommended), false only for full archive nodes
# If using a snapshot, this must match the snapshot type (pruning or full)
LIVE_PRUNING=true

# Live pruning retention period (in blocks, default: 172800 = ~2 days at 1 sec/block)
LIVE_PRUNING_RETENTION=172800

# Node configuration
SYNCMODE=full
VERBOSITY=3
MAXCONNECTIONS=100

# LevelDB cache size in MB (default: 40960 = ~40GB)
# Higher values improve sync performance but require more RAM
LDBCACHESIZE=40960

# Public IP for P2P NAT traversal (auto-detected if empty)
# Set this if running behind NAT and auto-detection fails
PUBLIC_IP=

# Additional flags (space-separated)
# Recommended for security: disable unsafe debug methods
EXTRA_FLAGS=--rpc.unsafe-debug.disable

# Secure web proxy - advanced use, please see instructions
DOMAIN=example.com
RPC_HOST=kaia
RPC_LB=kaia-lb
WS_HOST=kaiaws
WS_LB=kaiaws-lb

# External Docker network if using ext-network.yml
DOCKER_EXT_NETWORK=traefik_default

# You can pin the version of Kaia Docker here
SCRIPT_TAG=

# Used by kaiad update - please do not adjust
ENV_VERSION=1
