COMPOSE_FILE=kaia.yml
NETWORK=mainnet
PROJECT_NAME=kaia

# Kaia binary version
# Latest: v2.2.2 (March 2026)
# https://github.com/kaiachain/kaia/releases
KEN_VERSION=v2.2.2

# Snapshot URL for fast sync (HIGHLY RECOMMENDED)
# Latest snapshot: https://packages.kaia.io/mainnet/chaindata/
# Full node: 1.9TB compressed / 2.4TB uncompressed
# Without snapshot, initial sync takes 5-7+ days
SNAPSHOT=https://storage.googleapis.com/kaia-chaindata/mainnet/kaia-mainnet-chaindata-latest.tar.gz

# Sync mode: "full" or "snap"
SYNCMODE=full

# Port configuration
PORT=32323         # P2P port
RPC_PORT=8551      # HTTP JSON-RPC port
WS_PORT=8552       # WebSocket port

# RPC/WebSocket configuration
RPC_ADDR=0.0.0.0
WS_ADDR=0.0.0.0
RPC_API=klay,eth,net,web3
WS_API=klay,eth,net,web3
RPC_VHOSTS=*
RPC_CORSDOMAIN=*
WS_ORIGINS=*

# Secure web proxy - advanced use, please see instructions
DOMAIN=example.com
RPC_HOST=kaia
RPC_LB=kaia-lb
WS_HOST=kaiaws
WS_LB=kaiaws-lb

# Logging
LOG_LEVEL=info

# External Docker network if using ext-network.yml
DOCKER_EXT_NETWORK=traefik_default

# Additional flags (optional)
EXTRA_FLAGS=

# You can pin the version of Kaia Docker here
SCRIPT_TAG=

# Used by kaiad update - please do not adjust
ENV_VERSION=1
